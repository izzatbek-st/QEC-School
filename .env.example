APP_ENV=production

# 32+ belgili maxfiy kalit (Render Blueprint'da avtomatik generatsiya qilinadi)
APP_SECRET_KEY=

# Dastlabki admin paroli (kamida 12 belgi tavsiya etiladi)
INITIAL_ADMIN_PASSWORD=admin

# Parolni majburiy yangilash (zarur bo'lsa "true" qiling)
OVERWRITE_ADMIN_PASSWORD=false

# Ma'lumotlar bazasi va fayllar joylashuvi
DATABASE_URL=sqlite:////data/edumaster.db
UPLOADS_DIR=/data/uploads

# Tashqi domenlar uchun CORS (ixtiyoriy, vergul bilan ajratilgan)
CORS_ORIGINS=
